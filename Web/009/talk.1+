$(function() {
    $('#yes').click(function(event) {
        modal('我愛妳我的老婆', function() {
            $('.page_one').addClass('hide');
            $('.page_two').removeClass('hide');
            // typeWrite();
            fireworks();

        });
    });
    $('#no').click(function(event) {
        modal('老婆我真的', A);
    });
});

function A() {
    modal('好喜歡妳！', B);
}

function B() {
    modal('好愛妳', C);
}

function C() {
    modal('妳不開心就找我！', D);
}

function D() {
    modal('但是妳不許再把我推開了', E);
}

function E() {
    modal('我想身邊一直是妳', F);
}

function F() {
    modal('讓我們一直在一起吧', G);
}


function H() {
    modal('永遠不分開', function() {
        fireworks();
    });
}

function fireworks() {
    $('.page_one').addClass('hide');
    initAnimate();
}

function modal(content, callback) {
    var tpl = '<div class="container">'+
        '<div class="mask"></div>'+
        '<div class="modal">'+
        '<p>'+ content +'</p>'+
        '<button type="button" id="confirm" class="confirm">願意</button>'+
        '</div>'+
        '</div>';
    $('body').append(tpl);
    $(document).on('click', '.confirm', function() {
        $('.container').remove();
        callback();
    });
}
